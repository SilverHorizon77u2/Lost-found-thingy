<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" stylesheets="@../../styles/styles.css" styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.lfrs_group_4_oop.controller.ItemDetailController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox spacing="15.0" alignment="CENTER_LEFT" styleClass="nav-bar">
        <VBox.margin>
            <Insets top="-30.0" left="-30.0" right="-30.0" />
        </VBox.margin>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 0 15; -fx-background-color: -fx-brand-red; -fx-background-radius: 4px;">
            <ImageView fitHeight="30.0" preserveRatio="true">
                <Image url="@../../images/Polytechnic_University_of_the_Philippines.svg.png" />
            </ImageView>
        </HBox>
        <Button onAction="#onDashboardClick" text="Dashboard" styleClass="nav-link" />
        <Button onAction="#onMyReportsClick" text="My Reports" styleClass="nav-link" />
        <Button onAction="#onReportClick" text="Report" styleClass="nav-link" />
        <Button onAction="#onGalleryClick" text="Gallery" styleClass="nav-link" />
        <Button onAction="#onMapClick" style="-fx-background-color: transparent; -fx-text-fill: #E2E8F0; -fx-font-size: 14px; -fx-cursor: hand;" text="Campus Map" />

        <Region HBox.hgrow="ALWAYS" />

        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 0 15;">
            <StackPane fx:id="navAvatarContainer" onMouseClicked="#onProfileClick" styleClass="nav-avatar-container">
                <ImageView fx:id="headerAvatar" fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                    <clip>
                        <Circle radius="17.5" centerX="17.5" centerY="17.5" />
                    </clip>
                </ImageView>
            </StackPane>
        </HBox>
    </HBox>

    <Separator />

    <HBox spacing="30.0" VBox.vgrow="ALWAYS">
        <!-- Left Column: Image -->
        <VBox alignment="TOP_CENTER" spacing="15.0" styleClass="card" HBox.hgrow="NEVER" prefWidth="350.0">
            <StackPane fx:id="imageContainer" style="-fx-background-color: #E2E8F0; -fx-background-radius: 6px; -fx-min-height: 300px; -fx-min-width: 300px;">
                <ImageView fx:id="imageView" fitWidth="300.0" fitHeight="300.0" preserveRatio="true" />
            </StackPane>
            <VBox fx:id="instructionBox" spacing="5.0" style="-fx-background-color: #e8f4f8; -fx-padding: 10; -fx-border-color: #b3d4e0; -fx-border-radius: 6px;" managed="false" visible="false">
                <Label fx:id="instructionTitle" text="Instruction Title" styleClass="subtitle" style="-fx-font-weight: bold;"/>
                <Label fx:id="instructionBody" text="Instruction Body" wrapText="true" />
            </VBox>
        </VBox>

        <!-- Right Column: Details -->
        <VBox spacing="15.0" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="titleLabel" text="N/A" styleClass="h1" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="statusLabel" text="N/A" style="-fx-font-weight: bold; -fx-padding: 5 10; -fx-background-radius: 15; -fx-background-color: #E2E8F0;" />
            </HBox>
            
            <Separator />
            
            <GridPane hgap="20.0" vgap="15.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER" minWidth="100.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" />
                </columnConstraints>

                <Label text="Description:" styleClass="subtitle" GridPane.rowIndex="0" />
                <Label fx:id="descriptionLabel" text="N/A" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Category:" styleClass="subtitle" GridPane.rowIndex="1" />
                <Label fx:id="categoryLabel" text="N/A" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Location:" styleClass="subtitle" GridPane.rowIndex="2" />
                <Label fx:id="locationLabel" text="N/A" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Date Reported:" styleClass="subtitle" GridPane.rowIndex="3" />
                <Label fx:id="dateLabel" text="N/A" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </GridPane>

            <!-- Admin Controls -->
            <VBox fx:id="adminStatusBox" spacing="10.0" style="-fx-border-color: -fx-color-border; -fx-border-width: 1 0 0 0; -fx-padding: 20 0 0 0;" managed="false" visible="false">
                <Label text="Status Management" styleClass="subtitle" style="-fx-font-weight: bold;"/>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <ComboBox fx:id="adminStatusComboBox" prefWidth="150.0" styleClass="combo-box" />
                    <Button fx:id="updateStatusButton" onAction="#onUpdateStatusClick" text="Update Status" styleClass="button, btn-primary" />
                </HBox>
            </VBox>
        </VBox>
    </HBox>

    <!-- Footer -->
    <Region VBox.vgrow="ALWAYS" />
    <HBox styleClass="footer" VBox.vgrow="NEVER" alignment="CENTER" spacing="10.0">
        <VBox.margin>
            <Insets bottom="-30.0" left="-30.0" right="-30.0" />
        </VBox.margin>
        <ImageView fitHeight="30.0" preserveRatio="true">
            <Image url="@../../images/Polytechnic_University_of_the_Philippines.svg.png" />
        </ImageView>
        <Label text="© 2026 Group 4 OOP - All Rights Reserved." styleClass="footer-text"/>
    </HBox>
</VBox>