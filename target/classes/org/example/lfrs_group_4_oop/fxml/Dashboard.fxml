<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.*?>

<VBox prefHeight="600.0" prefWidth="800.0" stylesheets="@../styles/styles.css" styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.lfrs_group_4_oop.controller.DashboardController">

    <HBox alignment="CENTER_LEFT" styleClass="nav-bar" spacing="15.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: -fx-brand-red; -fx-background-radius: 4px; -fx-padding: 2 5;">
            <ImageView fitHeight="30.0" preserveRatio="true">
                <Image url="@../images/Polytechnic_University_of_the_Philippines.svg.png" />
            </ImageView>
        </HBox>
        <Button fx:id="navDashboard" onAction="#onDashboardClick" text="Dashboard" styleClass="nav-link" />
        <Button fx:id="navMyReports" onAction="#onMyReportsClick" text="My Reports" styleClass="nav-link" />
        <Button fx:id="navReport" onAction="#onReportClick" text="Report" styleClass="nav-link" />
        <Button fx:id="navGallery" onAction="#onGalleryClick" text="Gallery" styleClass="nav-link" />
        <Button fx:id="navMap" mnemonicParsing="false" onAction="#onMapClick" style="-fx-background-color: transparent; -fx-text-fill: #E2E8F0; -fx-font-size: 14px; -fx-cursor: hand;" text="Campus Map" />
        <Region HBox.hgrow="ALWAYS" />


        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <StackPane fx:id="navAvatarContainer" onMouseClicked="#onProfileClick" styleClass="nav-avatar-container">
                <ImageView fx:id="headerAvatar" fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                    <clip>
                        <Circle radius="17.5" centerX="17.5" centerY="17.5" />
                    </clip>
                </ImageView>
            </StackPane>
        </HBox>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
        <content>
            <VBox spacing="20.0">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>

                <HBox fx:id="welcomeContainer" alignment="CENTER_LEFT" spacing="10.0">
                    <Label fx:id="welcomeLabel" text="Welcome, User" style="-fx-text-fill: -fx-brand-red; -fx-padding: 10 0 10 0;">
                        <font>
                            <Font name="Segoe UI" size="32.0" />
                        </font>
                    </Label>
                </HBox>

                <VBox spacing="15.0">
                    <Label text="Overview" styleClass="h1" style="-fx-text-fill: -fx-brand-red; -fx-font-weight: normal; -fx-padding: 0 0 0 0;">
                        <font>
                            <Font size="18.0" />
                        </font>
                    </Label>

                    <FlowPane hgap="15.0" vgap="15.0">
                        <HBox styleClass="card, metric-card" alignment="CENTER_LEFT" spacing="15.0">
                            <StackPane styleClass="icon-container, icon-total">
                                <SVGPath content="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" fill="#718096" />
                            </StackPane>
                            <VBox alignment="CENTER_LEFT">
                                <Label text="Total Reports" styleClass="subtitle" />
                                <Label fx:id="totalReportsLabel" text="0" styleClass="metric-number" />
                                <Label fx:id="totalTrendLabel" text="" styleClass="trend-label" />
                            </VBox>
                        </HBox>

                        <HBox styleClass="card, metric-card, metric-lost" alignment="CENTER_LEFT" spacing="15.0">
                            <StackPane styleClass="icon-container, icon-lost">
                                <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="#D32F2F" />
                            </StackPane>
                            <VBox alignment="CENTER_LEFT">
                                <Label text="Lost Items" styleClass="subtitle" />
                                <Label fx:id="lostItemsLabel" text="0" styleClass="metric-number" />
                                <Label fx:id="lostTrendLabel" text="" styleClass="trend-label" />
                            </VBox>
                        </HBox>

                        <HBox styleClass="card, metric-card, metric-found" alignment="CENTER_LEFT" spacing="15.0">
                            <StackPane styleClass="icon-container, icon-found">
                                <SVGPath content="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="#388E3C" />
                            </StackPane>
                            <VBox alignment="CENTER_LEFT">
                                <Label text="Found Items" styleClass="subtitle" />
                                <Label fx:id="foundItemsLabel" text="0" styleClass="metric-number" />
                                <Label fx:id="foundTrendLabel" text="" styleClass="trend-label" />
                            </VBox>
                        </HBox>

                        <HBox styleClass="card, metric-card, metric-claimed" alignment="CENTER_LEFT" spacing="15.0">
                            <StackPane styleClass="icon-container, icon-claimed">
                                <SVGPath content="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" fill="#1976D2" />
                            </StackPane>
                            <VBox alignment="CENTER_LEFT">
                                <Label text="Claimed Items" styleClass="subtitle" />
                                <Label fx:id="claimedLabel" text="0" styleClass="metric-number" />
                                <Label fx:id="claimedTrendLabel" text="" styleClass="trend-label" />
                            </VBox>
                        </HBox>

                        <HBox styleClass="card, metric-card, metric-unclaimed" alignment="CENTER_LEFT" spacing="15.0">
                            <StackPane styleClass="icon-container, icon-unclaimed">
                                <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z M12.5 7H11v6l5.25 3.15.75-1.23-4.5-2.67z" fill="#F57F17" />
                            </StackPane>
                            <VBox alignment="CENTER_LEFT">
                                <Label text="Unclaimed Items" styleClass="subtitle" />
                                <Label fx:id="unclaimedLabel" text="0" styleClass="metric-number" />
                                <Label fx:id="unclaimedTrendLabel" text="" styleClass="trend-label" />
                            </VBox>
                        </HBox>
                    </FlowPane>

                    <VBox spacing="10.0" style="-fx-padding: 30 0 0 0;">
                        <Label text="Item Records" styleClass="h1" style="-fx-text-fill: -fx-brand-red; -fx-font-weight: normal;" />
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <TextField fx:id="searchField" promptText="Search description..." prefWidth="350.0" styleClass="text-field" />
                            <Button onAction="#toggleFilterPanel" text="Filter" styleClass="button, btn-outline">
                                <graphic>
                                    <SVGPath content="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z" fill="#64748B" scaleX="0.8" scaleY="0.8" />
                                </graphic>
                            </Button>
                            <Button fx:id="searchButton" onAction="#onPerformSearchClick" text="Search" styleClass="button, btn-primary">
                                <graphic>
                                    <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="white" scaleX="0.8" scaleY="0.8" />
                                </graphic>
                            </Button>
                            <Button onAction="#refreshMetrics" text="Reset" styleClass="button, btn-reset">
                                <graphic>
                                    <SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" fill="#94A3B8" scaleX="0.8" scaleY="0.8" />
                                </graphic>
                            </Button>
                        </HBox>
                    </VBox>

                    <VBox fx:id="filterPanel" spacing="10.0" styleClass="card" managed="false" visible="false">
                        <HBox spacing="15.0" alignment="CENTER_LEFT">
                            <Label text="Status:" />
                            <ComboBox fx:id="statusFilter" promptText="Any" prefWidth="100.0" styleClass="combo-box" />

                            <Label text="Category:" />
                            <ComboBox fx:id="categoryFilter" promptText="Any" prefWidth="150.0" styleClass="combo-box" />

                            <Label text="Year:" />
                            <ComboBox fx:id="yearFilter" promptText="Any" prefWidth="100.0" styleClass="combo-box" />

                            <Label text="Month:" />
                            <ComboBox fx:id="monthFilter" promptText="Any" prefWidth="100.0" styleClass="combo-box" />

                            <Button onAction="#onPerformSearchClick" text="Apply Filters" styleClass="button, btn-primary">
                                <graphic>
                                    <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="white" scaleX="0.8" scaleY="0.8" />
                                </graphic>
                            </Button>
                        </HBox>
                    </VBox>

                    <TableView fx:id="itemTable" prefHeight="350.0" stylesheets="@../styles/table.css">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="No records found." styleClass="subtitle"/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="titleColumn" prefWidth="100.0" text="Title">
                                <cellValueFactory><PropertyValueFactory property="title" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Status">
                                <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="dateColumn" prefWidth="100.0" text="Date Submitted">
                                <cellValueFactory><PropertyValueFactory property="displayDate" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="reportedByColumn" prefWidth="100.0" text="Reported By">
                                <cellValueFactory><PropertyValueFactory property="reporterName" /></cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 15 0 0 0;">
                        <HBox alignment="CENTER_LEFT" spacing="8.0" HBox.hgrow="ALWAYS">
                            <Label text="Items per page:" style="-fx-font-size: 13px; -fx-text-fill: -fx-color-text-secondary;" />
                            <ComboBox fx:id="pageSizeComboBox" prefWidth="80.0" styleClass="combo-box" />
                        </HBox>

                        <HBox alignment="CENTER" spacing="8.0">
                            <Button fx:id="firstPageButton" onAction="#onFirstPageClick" text="&lt;&lt;" styleClass="btn-outline" style="-fx-padding: 6 12; -fx-font-size: 13px;" />
                            <Button fx:id="prevPageButton" onAction="#onPrevPageClick" text="&lt;" styleClass="btn-outline" style="-fx-padding: 6 12; -fx-font-size: 13px;" />

                            <Label fx:id="pageLabel" text="Page 1 of 1" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: -fx-color-text-primary; -fx-padding: 0 12 0 12;" />

                            <Button fx:id="nextPageButton" onAction="#onNextPageClick" text="&gt;" styleClass="btn-outline" style="-fx-padding: 6 12; -fx-font-size: 13px;" />
                            <Button fx:id="lastPageButton" onAction="#onLastPageClick" text="&gt;&gt;" styleClass="btn-outline" style="-fx-padding: 6 12; -fx-font-size: 13px;" />
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                            <Label fx:id="totalItemsLabel" text="Total Records: 0" style="-fx-font-size: 13px; -fx-text-fill: -fx-color-text-secondary; -fx-font-weight: bold;" />
                        </HBox>
                    </HBox>
                </VBox>

                <HBox styleClass="footer" alignment="CENTER" spacing="10.0">
                    <ImageView fitHeight="30.0" preserveRatio="true">
                        <Image url="@../images/Polytechnic_University_of_the_Philippines.svg.png" />
                    </ImageView>
                    <Label text="© 2026 Group 4 OOP - All Rights Reserved." styleClass="footer-text"/>
                </HBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>