<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<VBox prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.lfrs_group_4_oop.controller.GalleryController">
    <children>
        <!-- Overhead Navbar (Matching Dashboard from image_ff771e.png) -->
        <HBox alignment="CENTER_LEFT" prefHeight="65.0" style="-fx-background-color: #C22727;" spacing="20.0">
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
            <children>
                <!-- System Logo Placeholder -->
                <StackPane prefWidth="40.0" prefHeight="40.0">
                    <children>
                        <ImageView fx:id="logoImageView" fitHeight="35.0" fitWidth="35.0" preserveRatio="true" />
                    </children>
                </StackPane>

                <!-- Navigation Action Triggers -->
                <HBox alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Button fx:id="navDashboard" mnemonicParsing="false" onAction="#onDashboardClick" style="-fx-background-color: transparent; -fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="Dashboard" />
                        <Button fx:id="navMyReports" mnemonicParsing="false" onAction="#onMyReportsClick" style="-fx-background-color: transparent; -fx-text-fill: #E2E8F0; -fx-font-size: 14px; -fx-font-weight: normal; -fx-cursor: hand;" text="My Reports" />
                        <Button fx:id="navReport" mnemonicParsing="false" onAction="#onReportClick" style="-fx-background-color: transparent; -fx-text-fill: #E2E8F0; -fx-font-size: 14px; -fx-font-weight: normal; -fx-cursor: hand;" text="Report" />
                        <Button fx:id="navMap" mnemonicParsing="false" onAction="#onMapClick" style="-fx-background-color: transparent; -fx-text-fill: #E2E8F0; -fx-font-size: 14px; -fx-cursor: hand;" text="Campus Map" />

                        <!-- Active Tab with Accent Underline Styling -->
                        <VBox alignment="CENTER" spacing="4.0">
                            <children>
                                <Button fx:id="navGallery" mnemonicParsing="false" onAction="#onGalleryClick" style="-fx-background-color: transparent; -fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="Gallery" />
                                <HBox prefHeight="3.0" prefWidth="50.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 2px;" />
                            </children>
                            <padding>
                                <Insets top="6.0" />
                            </padding>
                        </VBox>
                    </children>
                </HBox>

                <!-- Account Profile Container Element -->
                <StackPane fx:id="navAvatarContainer" onMouseClicked="#onProfileClick" style="-fx-cursor: hand;">
                    <children>
                        <ImageView fx:id="headerAvatar" fitHeight="40.0" fitWidth="40.0" preserveRatio="true" />
                    </children>
                </StackPane>
            </children>
        </HBox>

        <!-- Main Body Container Layout Content -->
        <VBox spacing="25.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="30.0" right="40.0" bottom="30.0" left="40.0" />
            </padding>
            <children>
                <!-- Content Header matching Theme Accents -->
                <VBox spacing="5.0">
                    <children>
                        <Label text="Photo Gallery" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #C22727;" />
                        <Label text="Visual collection of all reported lost and found items items." style="-fx-font-size: 14px; -fx-text-fill: #64748B;" />
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <TextField fx:id="searchField" promptText="Search description..." prefWidth="200.0" style="-fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-color: #FFFFFF;" />

                        <ComboBox fx:id="statusFilter" promptText="Filter by Status" prefWidth="120.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 4px;" />

                        <ComboBox fx:id="categoryFilter" promptText="All Categories" prefWidth="140.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 4px;" />

                        <ComboBox fx:id="locationFilter" promptText="All Locations" prefWidth="160.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 4px;" />

                        <Button fx:id="searchButton" mnemonicParsing="false" onAction="#onSearchClick" style="-fx-background-color: #C22727; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px 20px; -fx-background-radius: 6px; -fx-cursor: hand;" text="Search" />

                        <Button fx:id="resetButton" mnemonicParsing="false" onAction="#onResetClick" style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-padding: 8px 16px; -fx-background-radius: 6px; -fx-cursor: hand; -fx-border-color: #E2E8F0; -fx-border-radius: 6px;" text="Reset" />
                    </children>
                </HBox>
                <!-- Fluid Gallery Display Content Grid -->
                <TilePane fx:id="galleryTilePane" hgap="25.0" vgap="25.0" prefTileWidth="230.0" prefTileHeight="250.0" style="-fx-background-color: transparent;" />
            </children>
        </VBox>
    </children>
</VBox>